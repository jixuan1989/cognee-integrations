{
  "id": "cognee-openclaw",
  "name": "Memory (Cognee)",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Cognee API base URL (default: http://localhost:8000)"
      },
      "apiKey": {
        "type": "string",
        "description": "Cognee API key (or use ${COGNEE_API_KEY})"
      },
      "datasetName": {
        "type": "string",
        "description": "Cognee dataset name; use {agentId} for per-agent (e.g. openclaw-{agentId})"
      },
      "sharedDatasetName": {
        "type": "string",
        "description": "Optional shared dataset; search merges private+shared; agents can write via cognee_memory_share tool"
      },
      "searchType": {
        "type": "string",
        "enum": [
          "GRAPH_COMPLETION",
          "CHUNKS",
          "SUMMARIES"
        ],
        "description": "Cognee search mode"
      },
      "maxResults": {
        "type": "number",
        "description": "Max recall results to inject (default: 6)"
      },
      "minScore": {
        "type": "number",
        "description": "Minimum score to include in recall (default: 0)"
      },
      "maxTokens": {
        "type": "number",
        "description": "Token cap for recall (default: 512)"
      },
      "autoRecall": {
        "type": "boolean",
        "description": "Inject memories before each agent run (default: true)"
      },
      "autoIndex": {
        "type": "boolean",
        "description": "Auto-sync memory files to Cognee on plugin startup (default: true)"
      },
      "autoCognify": {
        "type": "boolean",
        "description": "Run cognify after new memories are added (default: true)"
      },
      "requestTimeoutMs": {
        "type": "number",
        "description": "HTTP timeout in milliseconds for Cognee requests (default: 60000)"
      },
      "dreaming": {
        "type": "object",
        "description": "Memory dreaming configuration (light/deep/REM phases)",
        "properties": {
          "enabled": { "type": "boolean" },
          "frequency": { "type": "string" },
          "timezone": { "type": "string" },
          "verboseLogging": { "type": "boolean" },
          "storage": {
            "type": "object",
            "properties": {
              "mode": { "type": "string" },
              "separateReports": { "type": "boolean" }
            }
          },
          "phases": {
            "type": "object",
            "properties": {
              "light": { "type": "object" },
              "deep": { "type": "object" },
              "rem": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "Base URL",
      "placeholder": "http://localhost:8000"
    },
    "apiKey": {
      "label": "API Key",
      "sensitive": true,
      "placeholder": "${COGNEE_API_KEY}"
    },
    "datasetName": {
      "label": "Dataset Name",
      "placeholder": "openclaw or openclaw-{agentId}"
    },
    "sharedDatasetName": {
      "label": "Shared Dataset",
      "placeholder": "openclaw-shared"
    },
    "searchType": {
      "label": "Search Type",
      "placeholder": "GRAPH_COMPLETION"
    },
    "maxResults": {
      "label": "Max Results",
      "placeholder": "6"
    },
    "minScore": {
      "label": "Min Score",
      "placeholder": "0"
    },
    "maxTokens": {
      "label": "Max Tokens",
      "placeholder": "512"
    },
    "autoRecall": {
      "label": "Auto-Recall"
    },
    "autoIndex": {
      "label": "Auto-Index on Startup"
    },
    "autoCognify": {
      "label": "Auto-Cognify"
    },
    "requestTimeoutMs": {
      "label": "Request Timeout (ms)",
      "placeholder": "60000"
    }
  }
}